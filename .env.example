# Copy this file to .env and fill in all values before running the server.
# Variables marked REQUIRED will cause the server to refuse to start if missing.

NODE_ENV=development
PORT=3000

# REQUIRED — random secret for signing session cookies (min 32 chars)
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# REQUIRED — TiDB / MySQL connection string
DATABASE_URL=mysql://user:password@host:4000/dbname?ssl={"rejectUnauthorized":true}

# OAuth (Manus platform)
VITE_OAUTH_PORTAL_URL=
VITE_APP_ID=
OAUTH_SERVER_URL=
OWNER_OPEN_ID=

# Email of the account that should automatically receive the admin role on login (Supabase auth)
OWNER_EMAIL=

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Analytics (optional)
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=

# Forge AI API (optional)
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=

# Internal API base URL
APP_API_URL=

# CORS allowed origin (production frontend URL)
CLIENT_ORIGIN=https://your-production-domain.com
