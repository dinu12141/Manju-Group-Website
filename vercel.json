{
  "version": 2,
  "installCommand": "npm i -g pnpm@9 && pnpm install",
  "buildCommand": "pnpm vercel-build",
  "outputDirectory": "dist/public",
  "functions": {
    "api/index.mjs": {}
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.mjs"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
