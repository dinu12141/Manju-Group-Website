{
  "version": 2,
  "installCommand": "npm i -g pnpm@9 && pnpm install",
  "buildCommand": "pnpm vercel-build",
  "outputDirectory": "dist/public",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
